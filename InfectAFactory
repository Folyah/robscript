----- Prompt scan -----

-- Every infectable object of a yard has a holder Part under Yard.Prompts named
-- after its ObjectId, with one ProximityPrompt. The server enables the prompt
-- only for objects the build chain has unlocked, so Enabled is our availability
-- flag and nothing has to be hardcoded.
local promptList = {}
local promptScanAt = 0

local function scanPrompts(force)
	if not force and os.clock() - promptScanAt < 0.5 then
		return promptList
	end
	promptScanAt = os.clock()
	local yard = findMyYard()
	local list = {}
	if not yard then
		promptList = list
		return list
	end
	local folder = yard:FindFirstChild("Prompts")
	if not folder then
		promptList = list
		return list
	end
	local infected = infectedMap()
	local scrubbed = scrubbedMap()
	for _, holder in ipairs(folder:GetChildren()) do
		local prompt = holder:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt and prompt.ActionText == "Infect" then
			local id = holder.Name
			local entry = catalog[id]
			local done = infected[id] == true and scrubbed[id] ~= true
			list[#list + 1] = {
				id = id,
				holder = holder,
				prompt = prompt,
				name = entry and entry.name or id,
				cost = entry and entry.cost or 0,
				income = entry and entry.income or 0,
				role = entry and entry.role or "",
				area = entry and entry.area or "",
				enabled = prompt.Enabled,
				infected = done,
				reinfect = infected[id] == true and scrubbed[id] == true,
			}
		end
	end
	promptList = list
	return list
end

local function yardName()
	local yard = findMyYard()
	return yard and yard.Name or nil
end

----- Economy -----

local economy = {
	rate = 0,
	rateSource = "none",
	measured = 0,
	modelRate = 0,
	hudRate = nil,
	rateSamples = {},
	hudIncome = nil,
	bondLabel = nil,
	bondTarget = nil,
	areaLabel = nil,
	areaHave = nil,
	areaTotal = nil,
	nextPurchase = nil,
	eligible = 0,
	affordable = 0,
}

local function sampleRate()
	local snapshot = state.snapshot
	if not snapshot or type(snapshot.goo) ~= "number" then
		return
	end
	local now = os.clock()
	local samples = economy.rateSamples
	samples[#samples + 1] = { t = now, goo = snapshot.goo }
	while #samples > 40 do
		table.remove(samples, 1)
	end
	-- Use a window of at least 2s so single snapshot jitter cannot fake a rate.
	local first = samples[1]
	local last = samples[#samples]
	if first and last and last.t - first.t >= 2 then
		local delta = last.goo - first.goo
		local elapsed = last.t - first.t
		local instant = delta / elapsed
		if instant < 0 then
			instant = 0
		end
		economy.measured = economy.measured * 0.6 + instant * 0.4
	end
end

local function readHud()
	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	local hud = gui and gui:FindFirstChild("HUD")
	if not hud then
		return
	end
	local income = labelText(hud, "Column.Stack.Income.Value")
	if income then
		economy.hudIncome = income
		-- "+17.3 goo/s" -> 17.3, "+1.2K goo/s" -> 1200
		economy.hudRate = parseCompact(income:match("%+?([%d%.]+%s*[KMBTkmbt]?)"))
	end
	local bond = labelText(hud, "Column.Stack.NextBond.Value")
	if bond then
		economy.bondLabel = bond
		local amount = bond:match("([%d%.]+%s*[KMBTkmbt]?)")
		economy.bondTarget = parseCompact(amount)
	end
	local areas = labelText(hud, "Column.Stack.Areas.Line1")
	if areas then
		economy.areaLabel = areas
		local have, total = areas:match("(%d+)%s*/%s*(%d+)")
		economy.areaHave = tonumber(have)
		economy.areaTotal = tonumber(total)
	end
end

local function refreshEconomy()
	readHud()
	local list = scanPrompts()
	local goo = currentGoo()
	local reserve = tonumber(flag("Reserve", 0)) or 0
	local cap = tonumber(flag("MaxPrice", 0)) or 0
	local eligible, affordable, best = 0, 0, nil
	for _, entry in ipairs(list) do
		if entry.enabled and not entry.infected then
			eligible = eligible + 1
			local budget = goo - reserve
			if entry.cost <= budget and (cap <= 0 or entry.cost <= cap) then
				affordable = affordable + 1
				if not best or entry.cost < best.cost then
					best = { id = entry.id, name = entry.name, cost = entry.cost, income = entry.income }
				end
			end
		end
	end
	economy.eligible = eligible
	economy.affordable = affordable
	economy.nextPurchase = best

	-- The balance delta lies while the farm is spending, so the game's own HUD
	-- number wins, then the catalog sum, and only then the measured delta.
	local modelRate = 0
	for id in pairs(infectedMap()) do
		local entry = catalog[id]
		if entry then
			modelRate = modelRate + entry.income
		end
	end
	economy.modelRate = modelRate

	if economy.hudRate and economy.hudRate > 0 then
		economy.rate = economy.hudRate
		economy.rateSource = "hud"
	elseif modelRate > 0.01 then
		economy.rate = modelRate
		economy.rateSource = "catalog"
	else
		economy.rate = economy.measured
		economy.rateSource = "measured"
	end
end

local function purchaseEta()
	local best = economy.nextPurchase
	if not best then
		return nil
	end
	local goo = currentGoo()
	local rate = economy.rate
	if rate <= 0 then
		return nil
	end
	return math.max(0, (best.cost - goo) / rate)
end

----- Farm engine -----

local HOLD_TIMEOUT = 9
local SETTLE_TIME = 0.3

local blacklist = {}

local farm = {
	running = false,
	busy = false,
	cycles = 0,
	failures = 0,
	status = "idle",
	target = nil,
	lastId = nil,
	lastError = nil,
	generation = 0,
}

local function priorityMode()
	return flag("Priority", "Chain order")
end

local function pickTarget(list)
	local goo = currentGoo()
	local reserve = tonumber(flag("Reserve", 0)) or 0
	local cap = tonumber(flag("MaxPrice", 0)) or 0
	local now = os.clock()
	local candidates = {}
	for _, entry in ipairs(list) do
		local blocked = blacklist[entry.id]
		if entry.enabled and (not entry.infected or entry.reinfect) and not (blocked and blocked > now) then
			if entry.cost <= goo - reserve and (cap <= 0 or entry.cost <= cap) then
				candidates[#candidates + 1] = entry
			end
		end
	end
	if #candidates == 0 then
		return nil, "waiting for goo"
	end
	local mode = priorityMode()
	if mode == "Chain order" then
		local wanted = nextObjectId()
		if wanted then
			for _, entry in ipairs(candidates) do
				if entry.id == wanted then
					return entry, "chain"
				end
			end
		end
	elseif mode == "Best income" then
		table.sort(candidates, function(a, b)
			if a.income ~= b.income then
				return a.income > b.income
			end
			return a.cost < b.cost
		end)
		return candidates[1], "income"
	end
	-- "Cheapest first" and the chain fallback both want the cheapest unlock.
	table.sort(candidates, function(a, b)
		return a.cost < b.cost
	end)
	return candidates[1], "cheapest"
end

local function infectOnce(entry)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "no character"
	end
	local holder = entry.holder
	if not holder or not holder.Parent then
		return false, "prompt gone"
	end
	farm.target = entry
	farm.status = string.format("infecting %s", entry.name)
	-- The server checks the distance itself, so the hold only counts while the
	-- character actually stands at the object.
	root.CFrame = CFrame.new(holder.Position + Vector3.new(0, 3.2, 0))
	task.wait(SETTLE_TIME)
	local ok, err = pcall(function()
		entry.prompt:InputHoldBegin()
	end)
	if not ok then
		farm.lastError = tostring(err)
		return false, "hold refused"
	end
	local started = os.clock()
	local done = false
	while os.clock() - started < HOLD_TIMEOUT do
		task.wait(0.1)
		if infectedMap()[entry.id] == true then
			done = true
			break
		end
		if not entry.prompt.Parent then
			break
		end
	end
	pcall(function()
		entry.prompt:InputHoldEnd()
	end)
	if done then
		blacklist[entry.id] = nil
		farm.cycles = farm.cycles + 1
		farm.lastId = entry.id
		farm.status = string.format("done: %s", entry.name)
		return true, "done"
	end
	blacklist[entry.id] = os.clock() + 20
	farm.failures = farm.failures + 1
	farm.status = string.format("failed: %s", entry.name)
	return false, "no infection"
end

local function farmStep()
	if farm.busy then
		return false, "busy"
	end
	farm.busy = true
	local ok, reached, reason = pcall(function()
		local entry, why = pickTarget(scanPrompts(true))
		if not entry then
			return false, why
		end
		return infectOnce(entry)
	end)
	farm.busy = false
	if not ok then
		farm.lastError = tostring(reached)
		farm.status = "error"
		return false, farm.lastError
	end
	return reached, reason
end

local function startFarm()
	if farm.running then
		return
	end
	farm.running = true
	farm.generation = farm.generation + 1
	local generation = farm.generation
	task.spawn(function()
		while farm.running and generation == farm.generation do
			if not flag("AutoFarm", false) then
				farm.status = "idle"
				task.wait(0.3)
			elseif not findMyYard() then
				farm.status = "no yard"
				task.wait(0.5)
			else
				local reached, reason = farmStep()
				if reached then
					if flag("Humanize", true) then
						task.wait(math.random(80, 320) / 1000)
					else
						task.wait(0.1)
					end
				elseif reason == "waiting for goo" then
					farm.status = string.format("waiting for goo (%s)", formatNumber(currentGoo()))
					task.wait(0.5)
				else
					task.wait(0.4)
				end
			end
		end
	end)
end

local function stopFarm()
	farm.running = false
	farm.generation = farm.generation + 1
	farm.status = "idle"
	farm.target = nil
end

