-- Airflow ships two theme APIs: the new AddTheme/SetTheme pair and the older
-- ThemePresets/SetDefaultTheme pair. Support both so a mirror update cannot
-- break the window, and always merge over the library defaults so keys such
-- as Success, Warning, Error and Glow stay valid.
local ThemeValue = THEME
do
	local merged = {}
	for key, value in pairs(Airflow.Theme or {}) do
		merged[key] = value
	end
	for key, value in pairs(THEME) do
		merged[key] = value
	end
	if type(Airflow.AddTheme) == "function" and type(Airflow.SetTheme) == "function" then
		local ok = pcall(function()
			Airflow:AddTheme("Robscript", merged)
			Airflow:SetTheme("Robscript")
		end)
		if ok then
			ThemeValue = "Robscript"
		end
	elseif type(Airflow.ThemePresets) == "table" then
		Airflow.ThemePresets.Robscript = merged
		pcall(function()
			Airflow:SetDefaultTheme("Robscript")
		end)
	end
end

