local function remotes()
	return ReplicatedStorage:FindFirstChild("Remotes")
end

do
	local container = remotes()
	local snapshotRemote = container and container:FindFirstChild("StateSnapshot")
	if snapshotRemote then
		snapshotRemote.OnClientEvent:Connect(function(payload)
			if type(payload) ~= "table" then
				return
			end
			-- Several yards can push snapshots; only the one carrying our own goo is ours.
			if payload.goo ~= nil and payload.infected ~= nil then
				state.snapshot = payload
				state.lastAt = os.clock()
			end
		end)
	end
end

local function currentGoo()
	local snapshot = state.snapshot
	if snapshot and type(snapshot.goo) == "number" then
