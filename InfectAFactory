----- Flags -----

local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local SUFFIXES = {
	{ "T", 1e12 },
	{ "B", 1e9 },
	{ "M", 1e6 },
	{ "K", 1e3 },
}

local function formatNumber(value)
	if type(value) ~= "number" or value ~= value then
		return "0"
	end
	for _, pair in ipairs(SUFFIXES) do
		if math.abs(value) >= pair[2] then
			return string.format("%.1f%s", value / pair[2], pair[1])
		end
	end
	if math.abs(value) >= 100 then
		return string.format("%d", math.floor(value + 0.5))
	end
	if math.abs(value) >= 10 then
		return string.format("%.1f", value)
	end
	return string.format("%.2f", value)
end

local function formatDuration(seconds)
	if type(seconds) ~= "number" or seconds ~= seconds or seconds == math.huge then
		return "—"
	end
	if seconds <= 0 then
		return "now"
	end
	if seconds < 60 then
		return string.format("%ds", math.ceil(seconds))
	end
	if seconds < 3600 then
		return string.format("%dm %ds", math.floor(seconds / 60), math.floor(seconds % 60))
	end
	return string.format("%dh %dm", math.floor(seconds / 3600), math.floor((seconds % 3600) / 60))
end

-- "58K", "1.2M", "3.4B" -> number. Used for the values the game prints in its own HUD.
local function parseCompact(text)
	if type(text) ~= "string" then
		return nil
	end
	local cleaned = text:gsub(",", ""):gsub("%s", "")
	local number, suffix = cleaned:match("([%d%.]+)([KkMmBbTt]?)")
	if not number then
		return nil
	end
	local value = tonumber(number)
	if not value then
		return nil
	end
	if suffix ~= "" then
		for _, pair in ipairs(SUFFIXES) do
			if pair[1] == suffix:upper() then
				value = value * pair[2]
				break
			end
		end
	end
	return value
end

local function addressOf(inst, path)
	local current = inst
	for part in string.gmatch(path, "[^%.]+") do
		if not current then
			return nil
		end
		current = current:FindFirstChild(part)
	end
	return current
end

local function labelText(inst, path)
	local node = addressOf(inst, path)
	if node and (node:IsA("TextLabel") or node:IsA("TextButton")) then
		return node.Text
	end
	return nil
end

----- Object catalog -----

-- The game ships its whole build tree in ReplicatedStorage.Shared.Objects.
-- Requiring it is read-only and gives cost, drip rate and prerequisites.
local catalog = {}
local catalogCount = 0

local function buildCatalog()
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("Objects")
	if not module then
		return 0
	end
	local ok, data = pcall(require, module)
	if not ok or type(data) ~= "table" then
		return 0
	end
	local count = 0
	for areaName, group in pairs(data) do
		if type(group) == "table" then
			for _, entry in pairs(group) do
				if type(entry) == "table" and type(entry.id) == "string" then
					local drip = tonumber(entry.dripInterval) or 1
					local blob = tonumber(entry.blobValue) or 0
					catalog[entry.id] = {
						id = entry.id,
						name = tostring(entry.name or entry.id),
						cost = tonumber(entry.cost) or 0,
						role = tostring(entry.role or ""),
						tier = tonumber(entry.tier) or 0,
						bond = tonumber(entry.bond) or 0,
						blobValue = blob,
						dripInterval = drip,
						income = blob > 0 and (blob / math.max(drip, 0.05)) or 0,
						requires = type(entry.requires) == "table" and entry.requires or {},
						area = tostring(areaName),
					}
					count = count + 1
				end
			end
		end
	end
	catalogCount = count
	return count
end

buildCatalog()

