	local stats = LocalPlayer:FindFirstChild("leaderstats")
	local goo = stats and stats:FindFirstChild("Goo")
	if goo and goo:IsA("IntValue") then
		return goo.Value
	end
	return 0
end

local function infectedMap()
	local snapshot = state.snapshot
	if snapshot and type(snapshot.infected) == "table" then
		return snapshot.infected
	end
	return {}
end

local function scrubbedMap()
	local snapshot = state.snapshot
	if snapshot and type(snapshot.scrubbed) == "table" then
		return snapshot.scrubbed
	end
	return {}
end

