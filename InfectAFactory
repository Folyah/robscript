----- Runtime -----

resetFlagCache()

local running = true
local heartbeatConnection = nil
local inputConnection = nil

startFarm()

task.spawn(function()
	while running do
		pcall(sampleRate)
		pcall(refreshEconomy)
		pcall(refreshOverlay)
		task.wait(0.25)
	end
end)

inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("AutoFarm", false)
			stopFarm()
			if overlayGui then
				overlayGui.Enabled = false
			end
			Window:Notify({ Title = "Stopped", Content = "Auto farm is off", Type = "Info" })
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	stopFarm()
	if heartbeatConnection then
		pcall(function()
			heartbeatConnection:Disconnect()
		end)
	end
	if inputConnection then
		pcall(function()
			inputConnection:Disconnect()
		end)
	end
	destroyOverlay()
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptIAF then
		getgenv().RobScriptIAF = nil
	end
end

----- Public interface -----

getgenv().RobScriptIAF = {
	Version = "1.0",
	Actions = {
		Start = function()
			setFlag("AutoFarm", true)
		end,
		Stop = function()
			setFlag("AutoFarm", false)
			stopFarm()
		end,
		InfectNext = function()
			return farmStep()
		end,
		Refresh = function()
			buildCatalog()
			refreshEconomy()
			refreshOverlay()
		end,
		Destroy = destroy,
	},
	GetStats = function()
		return {
			goo = currentGoo(),
			rate = economy.rate,
			cycles = farm.cycles,
			failures = farm.failures,
			eligible = economy.eligible,
			affordable = economy.affordable,
			status = farm.status,
			target = farm.target and farm.target.id or nil,
		}
	end,
	GetState = function()
		local snapshot = state.snapshot or {}
		return {
			goo = snapshot.goo,
			bonds = snapshot.bonds,
			nextObjectId = snapshot.nextObjectId,
			infected = snapshot.infected,
			scrubbed = snapshot.scrubbed,
			shop = snapshot.shop,
			yard = yardName(),
		}
	end,
	GetTargets = function()
		local list = {}
		for _, entry in ipairs(scanPrompts(true)) do
			list[#list + 1] = {
				id = entry.id,
				name = entry.name,
				cost = entry.cost,
				income = entry.income,
				area = entry.area,
				enabled = entry.enabled,
				infected = entry.infected,
			}
		end
		return list
	end,
	GetCatalog = function()
		return catalog
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	-- Everything a test run needs without anyone looking at the screen.
	Debug = function()
		return {
			loaded = running,
			yard = yardName(),
			catalog = catalogCount,
			snapshotAge = state.snapshot and (os.clock() - state.lastAt) or nil,
			goo = currentGoo(),
			rate = economy.rate,
			rateSource = economy.rateSource,
			hudRate = economy.hudRate,
			modelRate = economy.modelRate,
			measuredRate = economy.measured,
			eligible = economy.eligible,
			affordable = economy.affordable,
			target = farm.target and farm.target.id or nil,
			status = farm.status,
			cycles = farm.cycles,
			failures = farm.failures,
			lastError = farm.lastError,
			farmFlag = flag("AutoFarm", false),
			overlay = overlayGui ~= nil and overlayGui.Enabled or false,
			bondLabel = economy.bondLabel,
			areaLabel = economy.areaLabel,
			hudIncome = economy.hudIncome,
		}
	end,
	Destroy = destroy,
}

