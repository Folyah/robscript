----- Panic key and API -----

local API = {}

function API.GetStats()
	return {
		running = State.running,
		phase = State.phase,
		crashes = State.crashes,
		earned = sessionEarned(),
		lastGain = State.lastGain,
		balance = getMoney(),
		spot = State.spot,
	}
end

function API.Start()
	if AutoFarm then
		AutoFarm:Set(true)
	end
	startFarm()
end

function API.Stop()
	stopFarm()
	if AutoFarm then
		AutoFarm:Set(false, true)
	end
end

function API.SetSpot(position, direction)
	if typeof(position) == "Vector3" then
		State.spot = position
	end
	if typeof(direction) == "Vector3" and direction.Magnitude > 0.01 then
		State.direction = Vector3.new(direction.X, 0, direction.Z).Unit
	end
end

local panicConnection = nil
local antiAfkConnection = nil
do
	panicConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.End then
			if type(API.Destroy) == "function" then
				API.Destroy()
			end
		end
	end)
end

function API.Destroy()
	stopFarm()
	State.running = false
	State.__stopped = true
	if panicConnection then
		pcall(function()
			panicConnection:Disconnect()
		end)
		panicConnection = nil
	end
	if modsConnection then
		pcall(function()
			modsConnection:Disconnect()
		end)
		modsConnection = nil
	end
	if antiAfkConnection then
		pcall(function()
			antiAfkConnection:Disconnect()
		end)
		antiAfkConnection = nil
	end
	pcall(function()
		Window:Destroy()
	end)
	if getgenv().RobScriptBNG == API then
		getgenv().RobScriptBNG = nil
	end
end

getgenv().RobScriptBNG = API

----- Anti-AFK -----

-- Always on, no toggle. The client raises Idled only when it is about to kick for
-- being idle, so one virtual click there resets that timer and nothing else touches
-- player input while the farm is running.
antiAfkConnection = LocalPlayer.Idled:Connect(function()
	pcall(function()
		local VirtualUser = game:GetService("VirtualUser")
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
end)

