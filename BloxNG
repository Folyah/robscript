----- Helpers -----

local function formatNumber(value)
	local text = tostring(math.floor(math.abs(value) + 0.5))
	local k
	repeat
		text, k = string.gsub(text, "^(-?%d+)(%d%d%d)", "%1,%2")
	until k == 0
	if value < 0 then
		text = "-" .. text
	end
	return text
end

local function setPhase(text)
	State.phase = text
end

local function getCarsFolder()
	local crashTest = Workspace:FindFirstChild(CARS_FOLDER)
	return crashTest and crashTest:FindFirstChild("Cars") or nil
end

local function getCar()
	local folder = getCarsFolder()
	if not folder then
		return nil
	end
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and string.find(model.Name, LocalPlayer.Name, 1, true) then
			return model
		end
	end
	return nil
end

local function getCarCommand()
	local node = ReplicatedStorage:FindFirstChild("SoftBody")
	node = node and node:FindFirstChild("Remotes")
	node = node and node:FindFirstChild("CarCommand")
	if node and node:IsA("RemoteEvent") then
		return node
	end
	return nil
end

local function getMoney()
	local value = LocalPlayer:GetAttribute("Money")
	return typeof(value) == "number" and value or 0
end

-- The crash payout is paid out of a per minute budget and trickles in after the
-- impact, so the honest session figure is the balance delta, not the sum of the
-- per cycle gains.
local function sessionEarned()
	return getMoney() - (State.sessionStartMoney or getMoney())
end

local function getHumanoid()
	local character = LocalPlayer.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function getRoot()
	local character = LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function isSeated(car)
	local humanoid = getHumanoid()
	if not (humanoid and humanoid.SeatPart) then
		return false
	end
	local seat = car and car:FindFirstChild("DriverSeat", true)
	return seat ~= nil and humanoid.SeatPart == seat
end

local function seatIn(car)
	local humanoid, root = getHumanoid(), getRoot()
	if not (humanoid and root) then
		return false
	end
	local seat = car:FindFirstChild("DriverSeat", true)
	if not seat then
		return false
	end
	root.CFrame = seat.CFrame + Vector3.new(0, 2.5, 0)
	task.wait(0.12)
	pcall(function()
		seat:Sit(humanoid)
	end)
	task.wait(0.3)
	if humanoid.SeatPart ~= seat then
		pcall(function()
			humanoid.Sit = true
		end)
		task.wait(0.25)
	end
	return humanoid.SeatPart == seat
end

local function setVelocity(car, velocity)
	return pcall(function()
		for _, part in ipairs(car:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = velocity
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)
end

local function waitUntil(predicate, timeout, interval)
	local deadline = os.clock() + (timeout or CONFIG.WallClock)
	interval = interval or 0.1
	while os.clock() < deadline do
		if State.__stopped then
			return false
		end
		local ok, result = pcall(predicate)
		if ok and result then
			return true
		end
		task.wait(interval)
	end
	local ok, result = pcall(predicate)
	return ok and result or false
end

local function isRepaired(car)
	if not car then
		return false
	end
	local damage = car:GetAttribute("Damage") or 0
	local engine = car:GetAttribute("EngineHealth") or 1
	return damage < 0.02 and engine > 0.99
end

local function waitRepaired(timeout)
	return waitUntil(function()
		return isRepaired(getCar())
	end, timeout, 0.15)
end

local function launch(car, speed)
	local velocity = State.direction * speed
	local deadline = os.clock() + CONFIG.LaunchHold
	while os.clock() < deadline do
		setVelocity(car, velocity)
		task.wait(0.05)
	end
end

local function parkCar(car)
	pcall(function()
		car:PivotTo(CFrame.lookAt(State.spot, State.spot + State.direction))
	end)
	setVelocity(car, Vector3.zero)
end

local function repairCar()
	local remote = getCarCommand()
	if not remote then
		return false
	end
	local ok = pcall(function()
		remote:FireServer("repair")
	end)
	return ok
end

----- Car mods -----

-- Handling assist that runs on top of the game's own car physics. It only touches
-- the seat while the player is actually on the throttle or steering, so the crash
-- farm below is never disturbed by it.
local MODS = {
	Enabled = false,
	SpeedBoost = 60,
	MaxSpeedLimit = 400,
	TurnAssist = 40,
	Downforce = 50,
}

local function getVehicleSeat()
	local humanoid = getHumanoid()
	if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
		return humanoid.SeatPart
	end
	local folder = getCarsFolder()
	if folder then
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and string.find(model.Name, LocalPlayer.Name, 1, true) then
				local seat = model:FindFirstChild("DriverSeat", true)
				if seat and seat:IsA("VehicleSeat") then
					return seat
				end
			end
		end
	end
	return nil
end

local modsConnection = RunService.Heartbeat:Connect(function(dt)
	if not MODS.Enabled then
		return
	end

	local seat = getVehicleSeat()
	if not seat then
		return
	end

	local throttle = seat.ThrottleFloat
	local steer = seat.SteerFloat
	local velocity = seat.AssemblyLinearVelocity
	local speed = velocity.Magnitude

	if MODS.SpeedBoost > 0 and math.abs(throttle) > 0.05 then
		if speed < MODS.MaxSpeedLimit then
			local forward = seat.CFrame.LookVector * throttle
			local boost = forward * (MODS.SpeedBoost * dt * 2.2)
			local down = Vector3.new(0, -MODS.Downforce * dt * 0.5, 0)
			seat.AssemblyLinearVelocity = velocity + boost + down
		end
	end

	if MODS.TurnAssist > 0 and math.abs(steer) > 0.05 and speed > 10 then
		local speedScale = math.clamp(speed / 80, 0.7, 2.5)
		local targetYaw = -steer * (MODS.TurnAssist * 0.04) * speedScale
		local angular = seat.AssemblyAngularVelocity
		seat.AssemblyAngularVelocity = angular:Lerp(Vector3.new(angular.X, targetYaw, angular.Z), 0.35)

		local direction = seat.CFrame.LookVector * (throttle >= 0 and 1 or -1)
		local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		local aligned = flatVelocity:Lerp(direction * flatVelocity.Magnitude, 0.12)
		seat.AssemblyLinearVelocity = Vector3.new(aligned.X, velocity.Y, aligned.Z)
	end
end)

----- Farm cycle -----

local function readOptions()
	local speed = CONFIG.DefaultSpeed
	local settle = CONFIG.DefaultSettle
	local repairTimeout = CONFIG.DefaultRepairTimeout
	local reEnter = CONFIG.DefaultReEnter

	if Airflow.Flags.ImpactSpeed then
		speed = Airflow.Flags.ImpactSpeed:Get() or speed
	end
	if Airflow.Flags.SettleDelay then
		settle = Airflow.Flags.SettleDelay:Get() or settle
	end
	if Airflow.Flags.RepairTimeout then
		repairTimeout = Airflow.Flags.RepairTimeout:Get() or repairTimeout
	end
	if Airflow.Flags.ReEnterCar then
		reEnter = Airflow.Flags.ReEnterCar:Get()
	end

	return {
		speed = speed,
		settle = settle,
		repairTimeout = repairTimeout,
		reEnter = reEnter ~= false,
	}
end

local function runCrashCycle()
	local options = readOptions()

	local car = getCar()
	if not car then
		return false, "Your car is not in the world"
	end

	if not isSeated(car) and options.reEnter then
		setPhase("Entering the car")
		if not seatIn(car) then
			return false, "Could not sit in the driver seat"
		end
		car = getCar() or car
	end
	if not isSeated(car) then
		return false, "You are not in the driver seat"
	end

	if not isRepaired(car) then
		setPhase("Repairing the car")
		if not repairCar() then
			return false, "The repair command remote was not found"
		end
		if not waitRepaired(options.repairTimeout) then
			return false, "The car did not finish repairing"
		end
	else
		setPhase("Waiting for the car")
	end

	car = getCar() or car
	local moneyBefore = getMoney()

	setPhase("Launching")
	parkCar(car)
	task.wait(0.3)
	launch(car, options.speed)

	setPhase("Crashing")
	local crashed = waitUntil(function()
		local current = getCar()
		return current ~= nil and (current:GetAttribute("Damage") or 0) >= CONFIG.CrashDamage
	end, CONFIG.WallClock, 0.05)

	-- The payout comes out of a per minute budget and can land a moment after the
	-- impact, so wait for the balance to move before the gain is read.
	waitUntil(function()
		return getMoney() > moneyBefore
	end, CONFIG.PayoutWindow, 0.1)
	task.wait(options.settle)

	local gain = getMoney() - moneyBefore
	State.crashes = State.crashes + 1
	State.earned = State.earned + gain
	State.lastGain = gain

	setPhase("Repairing")
	local parkingCar = getCar() or car
	parkCar(parkingCar)
	task.wait(0.1)

	if not repairCar() then
		return false, "The repair command remote was not found"
	end

	if not waitRepaired(options.repairTimeout) then
		return false, "The car did not come back after the repair"
	end

	if not crashed then
		return false, "The launch did not damage the car"
	end

	Log:Push(string.format(
		"<Success>Crash %s</Success>  <Muted>+$%s</Muted>",
		formatNumber(State.crashes),
		formatNumber(gain)
	))

	return true
end

local function startFarm()
	if State.running then
		return
	end
	State.running = true
	State.__stopped = false
	State.sessionStart = os.clock()
	State.sessionStartMoney = getMoney()

	task.spawn(function()
		local failures = 0
		while State.running do
			local okCall, cycleOk, err = pcall(runCrashCycle)
			if not State.running then
				break
			end
			if not okCall then
				failures = failures + 1
				Log:Push("<Danger>Cycle error: " .. tostring(cycleOk) .. "</Danger>")
				task.wait(1)
			elseif not cycleOk then
				failures = failures + 1
				Log:Push("<Warning>" .. tostring(err) .. "</Warning>")
				task.wait(1)
			else
				failures = 0
			end
			if failures >= 3 then
				Log:Push("<Danger>Stopped after 3 failed cycles</Danger>")
				if AutoFarm then
					AutoFarm:Set(false)
				end
				State.running = false
				break
			end
		end
		State.running = false
		State.__stopped = true
		setPhase("Idle")
	end)
end

local function stopFarm()
	if not State.running then
		setPhase("Idle")
		return
	end
	State.running = false
	State.__stopped = true
	setPhase("Stopping")
end

