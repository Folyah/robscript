----- Flags -----

local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function distanceOrigin()
	if flag("DistanceFrom", "Camera") == "Character" then
		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			return root.Position
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function animalsFolder()
	local folder = workspace:FindFirstChild("Animals")
	if folder and folder:IsA("Folder") then
		return folder
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Folder") then
			local first = child:GetChildren()[1]
			if first and first:GetAttribute("Species") ~= nil then
				return child
			end
		end
	end
	return nil
end

local function adorneePart(model)
	local primary = model.PrimaryPart
	if primary then
		return primary
	end
	local named = model:FindFirstChild("RootPart") or model:FindFirstChild("Body")
	if named and named:IsA("BasePart") then
		return named
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			return child
		end
	end
	return nil
end

-- This game uses a 7.1 stud cube named RootPart as a hitbox, so it must never
-- feed the visual bounds: it would turn every deer into a square blob.
local extentCache = {}

local function animalExtent(model)
	local species = model:GetAttribute("Species") or model.Name
	local cached = extentCache[species]
	if cached then
		return cached
	end
	local fallback = SPECIES_EXTENT[species] or { 3, 3 }
	local lying = model:GetAttribute("Anim") == "LyingIdle"
	local minY, maxY = math.huge, -math.huge
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	local any = false
	if not lying then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "RootPart" then
				any = true
				local position, size = part.Position, part.Size
				minY = math.min(minY, position.Y - size.Y * 0.5)
				maxY = math.max(maxY, position.Y + size.Y * 0.5)
				minX = math.min(minX, position.X - size.X * 0.5)
				maxX = math.max(maxX, position.X + size.X * 0.5)
				minZ = math.min(minZ, position.Z - size.Z * 0.5)
				maxZ = math.max(maxZ, position.Z + size.Z * 0.5)
			end
		end
	end
	local height, width = fallback[1], fallback[2]
	local bottomOffset = -height * 0.4
	local base = model:GetAttribute("P")
	local hasBase = typeof(base) == "Vector3"
	if any then
		local measuredHeight = maxY - minY
		local measuredWidth = math.max(maxX - minX, maxZ - minZ)
		if measuredHeight > 0.2 then
			height = measuredHeight
		end
		if measuredWidth > 0.2 then
			width = measuredWidth
		end
		if hasBase then
			bottomOffset = minY - base.Y
		end
	end
	height = math.clamp(height, fallback[1] * 0.55, fallback[1] * 1.7)
	width = math.clamp(width, fallback[2] * 0.6, fallback[2] * 1.8)
	bottomOffset = math.clamp(bottomOffset, -height * 0.9, -height * 0.05)
	local extent = {
		height = height,
		width = width,
		aspect = width / math.max(height, 0.1),
		bottomOffset = bottomOffset,
	}
	if not lying then
		extentCache[species] = extent
	end
	return extent
end

