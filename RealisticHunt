----- Projection -----

local function projectPoint(position)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, false
	end
	local point, onScreen = camera:WorldToViewportPoint(position)
	return point, (onScreen and point.Z > 0)
end

-- Returns a screen rectangle for a world-space segment, or nil when the
-- segment is off screen, behind the camera or too small to read.
local function screenRect(top, bottom, aspect)
	local topPoint, topVisible = projectPoint(top)
	local bottomPoint, bottomVisible = projectPoint(bottom)
	if not topVisible or not bottomVisible then
		return nil
	end
	local pixelHeight = math.abs(bottomPoint.Y - topPoint.Y)
	if pixelHeight < 3 then
		return nil
	end
	local pixelWidth = math.max(pixelHeight * aspect, 5)
	local centerX = (topPoint.X + bottomPoint.X) * 0.5
	return {
		left = centerX - pixelWidth * 0.5,
		right = centerX + pixelWidth * 0.5,
		top = math.min(topPoint.Y, bottomPoint.Y),
		bottom = math.max(topPoint.Y, bottomPoint.Y),
		centerX = centerX,
		height = pixelHeight,
	}
end

local function hideLines(lines)
	for _, line in ipairs(lines) do
		if line then
			line.Visible = false
		end
	end
end

local function paintRect(lines, rect, color)
	if not lines[1] or not rect then
		return false
	end
	local corners = {
		{ Vector2.new(rect.left, rect.top), Vector2.new(rect.right, rect.top) },
		{ Vector2.new(rect.right, rect.top), Vector2.new(rect.right, rect.bottom) },
		{ Vector2.new(rect.right, rect.bottom), Vector2.new(rect.left, rect.bottom) },
		{ Vector2.new(rect.left, rect.bottom), Vector2.new(rect.left, rect.top) },
	}
	for index, line in ipairs(lines) do
		local corner = corners[index]
		line.From = corner[1]
		line.To = corner[2]
		line.Color = color
		line.Thickness = 1
		line.Transparency = 1
		line.Visible = true
	end
	return true
end

local function paintTracer(line, from, to, color)
	if not line then
		return
	end
	line.From = from
	line.To = to
	line.Color = color
	line.Thickness = 1
	line.Transparency = 1
	line.Visible = true
end

----- Visual objects -----

local function ensureHighlight(target, adornee, color)
	if target.highlight and target.highlight.Parent ~= adornee then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	if not target.highlight then
		local highlight = Instance.new("Highlight")
		highlight.Name = "RH_Chams"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 1
		highlight.Adornee = adornee
		highlight.Parent = adornee
		target.highlight = highlight
	end
	target.highlight.FillColor = color
	target.highlight.Enabled = true
end

local function ensureAnimalTarget(model)
	local target = animalTargets[model]
	if target then
		return target
	end
	target = {
		model = model,
		box = { newLine(), newLine(), newLine(), newLine() },
		nameText = newText(),
		infoText = newText(),
		tracer = newLine(),
		highlight = nil,
	}
	animalTargets[model] = target
	return target
end

local function ensureHunterTarget(player)
	local target = hunterTargets[player]
	if target then
		return target
	end
	target = {
		player = player,
		box = { newLine(), newLine(), newLine(), newLine() },
		nameText = newText(),
		infoText = newText(),
		tracer = newLine(),
		highlight = nil,
	}
	hunterTargets[player] = target
	return target
end

local function hideTarget(target)
	hideLines(target.box)
	if target.tracer then
		target.tracer.Visible = false
	end
	if target.nameText then
		target.nameText.Visible = false
	end
	if target.infoText then
		target.infoText.Visible = false
	end
	if target.highlight then
		target.highlight.Enabled = false
	end
end

local function releaseTarget(target)
	hideTarget(target)
	for _, line in ipairs(target.box) do
		releaseLine(line)
	end
	releaseLine(target.tracer)
	releaseText(target.nameText)
	releaseText(target.infoText)
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
end

----- Collection -----

local function collectAnimals()
	local folder = animalsFolder()
	if not folder then
		return
	end
	local showDead = flag("ShowDead", false)
	local filter = flag("SpeciesFilter", nil)
	local allowed = nil
	if type(filter) == "table" and #filter > 0 then
		allowed = {}
		for _, species in ipairs(filter) do
			allowed[species] = true
		end
	end

	local seen = {}
	local tracked = 0
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local dead = model:GetAttribute("Dead") == true
			local species = model:GetAttribute("Species") or model.Name
			if (showDead or not dead) and (not allowed or allowed[species]) then
				seen[model] = true
				tracked = tracked + 1
				local target = ensureAnimalTarget(model)
				target.species = species
				target.dead = dead
				target.label = model:GetAttribute("Id") or species
				target.grade = model:GetAttribute("Grade")
				target.sex = model:GetAttribute("Sex")
				target.weight = model:GetAttribute("WeightKg")
				target.wounded = model:GetAttribute("Wounded") == true
				target.bedded = model:GetAttribute("Bedded") == true
				target.alert = model:GetAttribute("Alert") == true
				target.fleeing = model:GetAttribute("Fleeing") == true
				local extent = animalExtent(model)
				target.height = extent.height
				target.aspect = extent.aspect
				target.bottomOffset = extent.bottomOffset
				target.baseColor = SPECIES_COLORS[species] or COLOR_DEFAULT_ANIMAL
				target.gradeColor = GRADE_COLORS[target.grade] or target.baseColor
			end
		end
	end

	for model, target in pairs(animalTargets) do
		if not seen[model] or not model.Parent then
			releaseTarget(target)
			animalTargets[model] = nil
		end
	end
	stats.tracked = tracked
end

local function collectHunters()
	local seen = {}
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				seen[player] = true
				count = count + 1
				ensureHunterTarget(player)
			end
		end
	end
	for player, target in pairs(hunterTargets) do
		if not seen[player] or not player.Parent then
			releaseTarget(target)
			hunterTargets[player] = nil
		end
	end
	stats.hunters = count
end

----- Per-frame updates -----

local function updateAnimal(target, session, origin)
	local model = target.model
	if not model or not model.Parent then
		return false
	end
	local base = model:GetAttribute("P")
	if typeof(base) ~= "Vector3" then
		local part = adorneePart(model)
		if not part then
			hideTarget(target)
			return false
		end
		base = part.Position
	end
	local distance = (base - origin).Magnitude
	if distance > session.maxDistance then
		hideTarget(target)
		return false
	end

	if session.chams then
		ensureHighlight(target, model, target.dead and session.deadColor or target.baseColor)
	end

	local bottom = base + Vector3.new(0, target.bottomOffset, 0)
	local top = bottom + Vector3.new(0, target.height, 0)
	local rect = screenRect(top, bottom, target.aspect)
	if not rect then
		hideLines(target.box)
		if target.tracer then
			target.tracer.Visible = false
		end
		if target.nameText then
			target.nameText.Visible = false
		end
		if target.infoText then
			target.infoText.Visible = false
		end
		return false
	end

	local color = target.dead and session.deadColor or target.baseColor
	if session.box then
		paintRect(target.box, rect, color)
	else
		hideLines(target.box)
	end

	if session.name and target.nameText then
		local text = target.label
		if session.distance then
			text = string.format("%s  |  %s", text, formatDistance(distance))
		end
		target.nameText.Text = text
		target.nameText.Color = target.dead and session.deadColor or target.gradeColor
		target.nameText.Size = 15
		target.nameText.Position = Vector2.new(rect.centerX, rect.top - 16)
		target.nameText.Visible = true
	elseif target.nameText then
		target.nameText.Visible = false
	end

	if session.info and target.infoText then
		local pieces = {}
		if target.grade then
			pieces[#pieces + 1] = target.grade
		end
		if target.weight then
			pieces[#pieces + 1] = string.format("%.1f kg", target.weight)
		end
		if target.sex == "Male" then
			pieces[#pieces + 1] = "M"
		elseif target.sex == "Female" then
			pieces[#pieces + 1] = "F"
		end
		if target.bedded then
			pieces[#pieces + 1] = "bedded"
		end
		if target.alert then
			pieces[#pieces + 1] = "alert"
		end
		if target.fleeing then
			pieces[#pieces + 1] = "fleeing"
		end
		if target.wounded then
			pieces[#pieces + 1] = "wounded"
		end
		if target.dead then
			pieces[#pieces + 1] = "dead"
		end
		target.infoText.Text = table.concat(pieces, "   ")
		target.infoText.Color = Color3.fromRGB(232, 232, 240)
		target.infoText.Size = 13
		target.infoText.Position = Vector2.new(rect.centerX, rect.bottom + 6)
		target.infoText.Visible = true
	elseif target.infoText then
		target.infoText.Visible = false
	end

	if session.tracer then
		paintTracer(target.tracer, session.tracerOrigin, Vector2.new(rect.centerX, rect.bottom), session.tracerColor)
	elseif target.tracer then
		target.tracer.Visible = false
	end
	return true
end

local function updateHunter(target, session, origin)
	local player = target.player
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		hideTarget(target)
		return false
	end
	local base = root.Position
	local distance = (base - origin).Magnitude
	if distance > session.maxDistance then
		hideTarget(target)
		return false
	end

	if session.chams then
		ensureHighlight(target, character, session.hunterColor)
	end

	local bottom = base - Vector3.new(0, PLAYER_BOX.height * 0.5, 0)
	local top = base + Vector3.new(0, PLAYER_BOX.height * 0.5, 0)
	local rect = screenRect(top, bottom, PLAYER_BOX.width / PLAYER_BOX.height)
	if not rect then
		hideLines(target.box)
		if target.tracer then
			target.tracer.Visible = false
		end
		if target.nameText then
			target.nameText.Visible = false
		end
		if target.infoText then
			target.infoText.Visible = false
		end
		return false
	end

	if session.box then
		paintRect(target.box, rect, session.hunterColor)
	else
		hideLines(target.box)
	end

	if session.name and target.nameText then
		local text = player.Name
		if session.distance then
			text = string.format("%s  |  %s", text, formatDistance(distance))
		end
		target.nameText.Text = text
		target.nameText.Color = session.hunterColor
		target.nameText.Size = 15
		target.nameText.Position = Vector2.new(rect.centerX, rect.top - 16)
		target.nameText.Visible = true
	elseif target.nameText then
		target.nameText.Visible = false
	end
	if target.infoText then
		target.infoText.Visible = false
	end

	if session.tracer then
		paintTracer(target.tracer, session.tracerOrigin, Vector2.new(rect.centerX, rect.bottom), session.tracerColor)
	elseif target.tracer then
		target.tracer.Visible = false
	end
	return true
end

----- Session -----

local function buildSession()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	return {
		origin = distanceOrigin(),
		maxDistance = flag("RenderDistance", 1500),
		box = flag("AnimalBox", true),
		name = flag("AnimalName", true),
		info = flag("AnimalInfo", true),
		distance = flag("AnimalDistance", true),
		chams = flag("AnimalChams", true),
		tracer = flag("AnimalTracer", false),
		tracerColor = flag("TracerColor", COLOR_DEFAULT_TRACER),
		tracerOrigin = Vector2.new(viewport.X * 0.5, viewport.Y),
		deadColor = flag("DeadColor", COLOR_DEFAULT_DEAD),
		hunterEnabled = flag("HunterESP", false),
		hunterBox = flag("HunterBox", true),
		hunterName = flag("HunterName", true),
		hunterDistance = flag("HunterDistance", true),
		hunterChams = flag("HunterChams", true),
		hunterTracer = flag("HunterTracer", false),
		hunterColor = flag("HunterColor", COLOR_DEFAULT_PLAYER),
	}
end

local function clearAll()
	for model, target in pairs(animalTargets) do
		releaseTarget(target)
		animalTargets[model] = nil
	end
	for player, target in pairs(hunterTargets) do
		releaseTarget(target)
		hunterTargets[player] = nil
	end
	stats.tracked = 0
	stats.hunters = 0
	stats.drawn = 0
end

local function refresh()
	local session = buildSession()

	local drawn = 0
	if flag("AnimalESP", true) then
		for _, target in pairs(animalTargets) do
			local ok, visible = pcall(updateAnimal, target, session, session.origin)
			if ok and visible then
				drawn = drawn + 1
			end
		end
	else
		for _, target in pairs(animalTargets) do
			hideTarget(target)
		end
	end
	stats.drawn = drawn

	local hunterSession = {
		maxDistance = session.maxDistance,
		box = session.hunterBox,
		name = session.hunterName,
		distance = session.hunterDistance,
		chams = session.hunterChams,
		tracer = session.hunterTracer,
		tracerColor = session.tracerColor,
		tracerOrigin = session.tracerOrigin,
		hunterColor = session.hunterColor,
	}
	if session.hunterEnabled then
		for _, target in pairs(hunterTargets) do
			pcall(updateHunter, target, hunterSession, session.origin)
		end
	else
		for _, target in pairs(hunterTargets) do
			hideTarget(target)
		end
	end
end

