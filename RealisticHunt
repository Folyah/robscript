----- Runtime -----

resetFlagCache()

local collectAccumulator = 0
local visualAccumulator = 0

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	collectAccumulator = collectAccumulator + deltaTime
	visualAccumulator = visualAccumulator + deltaTime

	if collectAccumulator >= COLLECT_INTERVAL then
		collectAccumulator = 0
		pcall(collectAnimals)
		pcall(collectHunters)
	end

	if visualAccumulator >= VISUAL_INTERVAL then
		visualAccumulator = 0
		pcall(refresh)
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("AnimalESP", false)
			setFlag("HunterESP", false)
			clearAll()
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	clearAll()
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptRH then
		getgenv().RobScriptRH = nil
	end
end

----- Public interface -----

getgenv().RobScriptRH = {
	Version = "1.0",
	Actions = {
		Refresh = function()
			collectAnimals()
			collectHunters()
			refresh()
		end,
		Clear = clearAll,
		Destroy = destroy,
	},
	GetStats = function()
		return { tracked = stats.tracked, hunters = stats.hunters, drawn = stats.drawn }
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	GetTargets = function()
		local list = {}
		for _, target in pairs(animalTargets) do
			list[#list + 1] = {
				label = target.label,
				species = target.species,
				grade = target.grade,
				dead = target.dead,
				color = target.baseColor,
			}
		end
		return list
	end,
	-- Drawing state straight from the render objects, so a test run can confirm
	-- the boxes land on screen without anyone having to look at the window.
	Debug = function()
		local list = {}
		for _, target in pairs(animalTargets) do
			local line = target.box[1]
			local entry = {
				label = target.label,
				box = (line ~= nil and line.Visible) or false,
				name = (target.nameText ~= nil and target.nameText.Visible) or false,
				info = (target.infoText ~= nil and target.infoText.Visible) or false,
				tracer = (target.tracer ~= nil and target.tracer.Visible) or false,
				chams = (target.highlight ~= nil and target.highlight.Enabled) or false,
			}
			if line and line.Visible then
				entry.rect = string.format("%d,%d %dx%d", math.floor(line.From.X), math.floor(line.From.Y),
					math.floor(line.To.X - line.From.X), math.floor(math.abs(line.To.Y - line.From.Y)))
			end
			list[#list + 1] = entry
		end
		return list
	end,
	Destroy = destroy,
}

