----- Runtime -----

resetFlagCache()
stats.kOs = knockoutCount()

local loopThread = task.spawn(function()
	while running do
		if flag("KOFarm", false) then
			local ok, err = pcall(farmStep)
			if not ok then
				stats.mode = "error"
				warn("[RobScript HRR] farm step failed: " .. tostring(err))
			end
		else
			stats.mode = "idle"
			local character = currentCharacter()
			local humanoid = humanoidOf(character)
			if humanoid and savedWalkSpeed ~= nil then
				releaseCharacter(humanoid)
			end
			if workspace.CurrentCamera and workspace.CurrentCamera.CameraType == Enum.CameraType.Scriptable then
				restoreCamera()
			end
			task.wait(0.4)
		end
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if not running then
		return
	end
	local farmKey = keyNameToEnum(flag("FarmKey", "X"))
	local panicKey = keyNameToEnum(flag("PanicKey", "End"))
	-- The panic key is honoured even while a text field has focus; the farm key is
	-- not, so typing in chat can never start the farm.
	if panicKey and input.KeyCode == panicKey then
		pcall(function()
			setFlag("KOFarm", false)
			setFlag("KeepPlatform", false)
			local character = currentCharacter()
			releaseCharacter(humanoidOf(character))
			restoreCamera()
		end)
		stats.mode = "idle"
		Window:Notify({ Title = "Panic", Content = "Farm stopped, control returned", Type = "Warning" })
		return
	end
	if processed then
		return
	end
	if farmKey and input.KeyCode == farmKey then
		local enabled = not flag("KOFarm", false)
		setFlag("KOFarm", enabled)
		Window:Notify({
			Title = "KO Farm",
			Content = enabled and "Farm started" or "Farm stopped",
			Type = enabled and "Success" or "Info",
		})
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		inputConnection:Disconnect()
	end)
	pcall(function()
		task.cancel(loopThread)
	end)
	local character = currentCharacter()
	releaseCharacter(humanoidOf(character))
	restoreCamera()
	pcall(function()
		removePlatform()
	end)
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptHRR then
		getgenv().RobScriptHRR = nil
	end
end

----- Public interface -----

getgenv().RobScriptHRR = {
	Version = "1.0",
	Set = function(name, value)
		return setFlag(name, value)
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	GetStats = function()
		return {
			downs = stats.downs,
			shots = stats.shots,
			kOs = stats.kOs,
			targets = stats.targets,
			mode = stats.mode,
		}
	end,
	Platform = {
		Build = buildPlatform,
		Remove = removePlatform,
		Stand = standOnPlatform,
	},
	Destroy = destroy,
}

----- Boot -----

pcall(function()
	Window:LoadAutoload()
end)

Window:Notify({ Title = "Robscript Team", Content = "KO farm is ready", Type = "Success" })

return getgenv().RobScriptHRR
