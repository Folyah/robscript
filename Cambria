	if flag("WarmDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	local text = "<font color=\"#FFFFFF\">Warm zone</font>"
	if #details > 0 then
		text = text .. string.format("\n<font color=\"#A6AEBE\">%s</font>", table.concat(details, "  |  "))
	end
	return text
end

----- Creature colors -----

local function ownSize()
	local character = LocalPlayer.Character
	return character and character:GetAttribute("Size") or nil
end

local function creatureColor(creature)
	if not flag("ThreatColors", true) then
		return flag("CreatureColor", COLOR_CREATURE)
	end
	local size = creature:GetAttribute("Size")
	local mine = ownSize()
	if type(size) ~= "number" or type(mine) ~= "number" or mine <= 0 then
		return flag("CreatureColor", COLOR_CREATURE)
	end
	local ratio = size / mine
	if ratio >= 1.35 then
		return flag("DangerColor", COLOR_DANGER)
	elseif ratio >= 1.1 then
		return flag("ThreatColor", COLOR_THREAT)
	elseif ratio <= 0.75 then
		return flag("PreyColor", COLOR_PREY)
	end
	return flag("CreatureColor", COLOR_CREATURE)
end

local function nodeColor(model)
	local kind = model:GetAttribute("FoodKind")
	if kind == "Mineral" then
		return flag("MineralColor", COLOR_MINERAL)
	end
	if kind == "Plant" then
		return flag("PlantColor", COLOR_PLANT)
	end
	return flag("MineralColor", COLOR_MINERAL)
end

----- Collection -----

local function ensureTarget(key, spec)
	local target = targets[key]
	if target then
		target.spec = spec
		target.misses = 0
		return target
	end
	target = {
		key = key,
		spec = spec,
		misses = 0,
		lastTextAt = 0,
		text = "",
		hasVisual = false,
	}
	targets[key] = target
	return target
end

local function resolvePart(target)
	local spec = target.spec
	if not spec then
		return nil
	end
	local part = spec.getPart and spec.getPart() or nil
	target.part = part
	return part
end

local function creatureOffsetY(creature)
	local size = creature:GetAttribute("Size")
	if type(size) == "number" then
		return 1.6 + size * 1.9
	end
	return 4
end

-- Early distance filter: collectors skip far objects, so the registry only
-- holds what can actually be on screen.
local collectOrigin = nil
local collectLimit = 1800

local function inCollectRange(position)
	if not position then
		return false
	end
	if not collectOrigin then
		return true
	end
	return (position - collectOrigin).Magnitude <= collectLimit
end

-- Food props are only worth drawing close by; a shorter range keeps the
-- registry small on a map that is covered in plants and ore.
local NODE_RANGE = 700

local function inNodeRange(position)
	if not position then
		return false
	end
	if not collectOrigin then
		return true
	end
	return (position - collectOrigin).Magnitude <= math.min(collectLimit, NODE_RANGE)
end

local function collectCreatures(seen)
	if not flag("CreatureESP", true) then
		return
	end
	local ignoreSmaller = flag("HideSmaller", false)
	local mine = ownSize()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local creature = player.Character
			if creature and creature.Parent then
				local root = creature:FindFirstChild("HumanoidRootPart")
				if root then
					local size = creature:GetAttribute("Size")
					local show = true
					if ignoreSmaller and type(size) == "number" and type(mine) == "number" and size < mine * 0.9 then
						show = false
					end
					if show then
						local target = ensureTarget(creature, {
							cat = "Creature",
							getPart = function()
								return creature:FindFirstChild("HumanoidRootPart")
							end,
							getChamPart = function()
								return bestVisualPart(player.Name)
							end,
							getOffsetY = function()
								return creatureOffsetY(creature)
							end,
							getPos = function()
								local current = creature:FindFirstChild("HumanoidRootPart")
								return current and current.Position or nil
							end,
							getColor = function()
								return creatureColor(creature)
							end,
							getText = creatureLabel,
							getBounds = function()
								return visualBounds(player.Name)
							end,
							tracer = true,
						})
						target.player = player
						target.creature = creature
						seen[target] = true
					end
				end
			end
		end
	end
end

local function collectCritters(seen)
	if not flag("CritterESP", false) then
		return
	end
	local container = workspace:FindFirstChild("Creatures")
	local critters = container and container:FindFirstChild("Critters")
	if not critters then
		return
	end
	for _, critter in ipairs(critters:GetChildren()) do
		if critter:IsA("Model") and critter:FindFirstChild("HumanoidRootPart") then
			local target = ensureTarget(critter, {
				cat = "Critter",
				getPart = function()
					return critter:FindFirstChild("HumanoidRootPart")
				end,
				getChamPart = function()
					return bestVisualPart("Critter")
				end,
				getOffsetY = function()
					local size = critter:GetAttribute("Size")
					return type(size) == "number" and (1.4 + size * 1.6) or 3
				end,
				getPos = function()
					local root = critter:FindFirstChild("HumanoidRootPart")
					return root and root.Position or nil
				end,
				getColor = function()
					return flag("CritterColor", COLOR_CRITTER)
				end,
				getText = critterLabel,
				getBounds = function()
					return visualBounds("Critter")
				end,
			})
			target.creature = critter
			seen[target] = true
		end
	end
end

local function firstPart(model)
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			return child
		end
	end
	local ok, descendant = pcall(function()
		return model:FindFirstChildWhichIsA("BasePart", true)
	end)
	if ok then
		return descendant
	end
	return nil
end

-- Position of anything that holds food data: a part when it has one, the
-- pivot when the meshes are managed by the client (meat carcasses).
local function modelPosition(model)
	local part = firstPart(model)
	if part then
		return part.Position
	end
	local ok, pivot = pcall(function()
		return model:GetPivot().Position
	end)
	if ok then
		return pivot
	end
	return nil
end

local function collectCarcasses(seen)
	if not flag("CarcassESP", true) then
		return
	end
	local hideRotten = flag("HideRotten", true)
	local container = workspace:FindFirstChild("Carcasses")
	if not container then
		return
	end
	for _, model in ipairs(container:GetChildren()) do
		if model:IsA("Model") and model:GetAttribute("FoodKind") == "Meat" then
			local rotten = model:GetAttribute("Rotten") == true
			if not (hideRotten and rotten) and inCollectRange(modelPosition(model)) then
				local target = ensureTarget(model, {
					cat = "Carcass",
					getPos = function()
						local ok, pivot = pcall(function()
							return model:GetPivot().Position
						end)
						return ok and pivot or nil
					end,
					getChamPart = function()
						return firstPart(model)
					end,
					getOffsetY = function()
						return 3
					end,
					getColor = function()
						return rotten and flag("RottenColor", COLOR_ROTTEN) or flag("MeatColor", COLOR_MEAT)
					end,
					getText = carcassLabel,
				})
				target.instance = model
				seen[target] = true
			end
		end
	end
end

local function collectNodes(seen)
	if not flag("NodeESP", false) then
		return
	end
	local showMineral = flag("NodeMineral", true)
	local showPlant = flag("NodePlant", true)
	local minUnits = flag("NodeMinUnits", 0)
	local props = workspace:FindFirstChild("World")
	props = props and props:FindFirstChild("Props")
	if not props then
		return
	end
	for _, chunk in ipairs(props:GetChildren()) do
		for _, model in ipairs(chunk:GetChildren()) do
			if model:IsA("Model") then
				local kind = model:GetAttribute("FoodKind")
				if kind == "Mineral" or kind == "Plant" then
					local units = model:GetAttribute("FoodUnits")
					local allowed = (kind == "Mineral" and showMineral) or (kind == "Plant" and showPlant)
					if allowed and type(units) == "number" and units >= minUnits and inNodeRange(modelPosition(model)) then
						local target = ensureTarget(model, {
							cat = "Node",
							getPart = function()
								return firstPart(model)
							end,
							getChamPart = function()
								return firstPart(model)
							end,
							getPos = function()
								local part = firstPart(model)
								return part and part.Position or nil
							end,
							getOffsetY = function()
								return 2.4
							end,
							getColor = function()
								return nodeColor(model)
							end,
							getText = nodeLabel,
						})
						target.instance = model
						seen[target] = true
					end
				end
			end
		end
	end
end

