----- Creature visuals (the meshes live outside the character model) -----

local function visualFolder(name)
	local container = workspace:FindFirstChild("CreatureVisuals")
	if not container then
		return nil
	end
	local folder = container:FindFirstChild(name)
	if folder and #folder:GetChildren() > 0 then
		return folder
	end
	return nil
end

local function bestVisualPart(name)
	local folder = visualFolder(name)
	if not folder then
		return nil
	end
	local best, bestVolume = nil, -1
	for _, descendant in ipairs(folder:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Transparency < 0.9 then
			local size = descendant.Size
			local volume = size.X * size.Y * size.Z
			if volume > bestVolume then
				best, bestVolume = descendant, volume
			end
		end
	end
	return best
end

local function visualBounds(name)
	local folder = visualFolder(name)
	if not folder then
		return nil
	end
	local minPoint = Vector3.new(math.huge, math.huge, math.huge)
	local maxPoint = Vector3.new(-math.huge, -math.huge, -math.huge)
	local found = false
	for _, descendant in ipairs(folder:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Transparency < 0.9 then
			local position = descendant.Position
			local half = descendant.Size * 0.5
			minPoint = Vector3.new(
				math.min(minPoint.X, position.X - half.X),
				math.min(minPoint.Y, position.Y - half.Y),
				math.min(minPoint.Z, position.Z - half.Z)
			)
			maxPoint = Vector3.new(
				math.max(maxPoint.X, position.X + half.X),
				math.max(maxPoint.Y, position.Y + half.Y),
				math.max(maxPoint.Z, position.Z + half.Z)
			)
			found = true
		end
	end
	if not found then
		return nil
	end
	return (minPoint + maxPoint) * 0.5, maxPoint - minPoint
end

