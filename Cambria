----- Flags -----

local flagCache = {}

local function resetFlagCache()
	flagCache = {}
end

local function getFlag(name)
	local cached = flagCache[name]
	if cached ~= nil then
		return cached ~= false and cached or nil
	end
	local container = Airflow.Flags
	local entry = type(container) == "table" and container[name] or nil
	if type(entry) == "table" then
		flagCache[name] = entry
		return entry
	end
	flagCache[name] = false
	return nil
end

local function flag(name, fallback)
	local entry = getFlag(name)
	if not entry then
		return fallback
	end
	local ok, value = pcall(function()
		return entry:Get()
	end)
	if ok and value ~= nil then
		return value
	end
	return fallback
end

local function setFlag(name, value)
	local entry = getFlag(name)
	if not entry then
		return false
	end
	return (pcall(function()
		entry:Set(value)
	end))
end

----- Helpers -----

local function colorToHex(color)
	local red = math.floor(math.clamp(color.R, 0, 1) * 255 + 0.5)
	local green = math.floor(math.clamp(color.G, 0, 1) * 255 + 0.5)
	local blue = math.floor(math.clamp(color.B, 0, 1) * 255 + 0.5)
	return string.format("#%02X%02X%02X", red, green, blue)
end

local function distanceOrigin()
	if flag("DistanceFrom", "Camera") == "Character" then
		local character = LocalPlayer.Character
		if character then
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then
				return root.Position
			end
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	return Vector3.zero
end

local function formatDistance(studs)
	if studs >= 1000 then
		return string.format("%.1fk", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function prettyName(rawName)
	local words = {}
	for word in string.gmatch(rawName, "[^_]+") do
		if not tonumber(word) then
			words[#words + 1] = word:sub(1, 1):upper() .. word:sub(2)
		end
	end
	if #words == 0 then
		return rawName
	end
	return table.concat(words, " ")
end

local function round(value)
	return math.floor(value + 0.5)
end

----- Shared game data -----

local function loadSharedData()
	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
	if not sharedFolder then
		return
	end

	local tiersModule = sharedFolder:FindFirstChild("Tiers")
	if tiersModule then
		pcall(function()
			local tiers = require(tiersModule)
			for index = 1, #TIER_NAMES do
				local entry = tiers[index]
				if type(entry) == "table" and type(entry.name) == "string" then
					TIER_NAMES[index] = entry.name
				end
			end
		end)
	end

	local placesModule = sharedFolder:FindFirstChild("Map2Places")
	if placesModule then
		pcall(function()
			local places = require(placesModule)
			local list = type(places.all) == "function" and places.all() or nil
			if type(list) == "table" then
				for _, place in ipairs(list) do
					if type(place) == "table" and typeof(place.position) == "Vector3" then
						PLACES[#PLACES + 1] = {
							name = tostring(place.name or "Place"),
							biome = tostring(place.biome or ""),
							kind = tostring(place.kind or ""),
							importance = tonumber(place.importance) or 1,
							position = place.position,
						}
					end
				end
			end
		end)
	end

	local cavesModule = sharedFolder:FindFirstChild("Caves")
	if cavesModule then
		pcall(function()
			local caves = require(cavesModule)
			local list = type(caves.entrances) == "function" and caves.entrances() or nil
			if type(list) == "table" then
				for _, entrance in ipairs(list) do
					local position = entrance.at
					if typeof(position) == "Vector3" then
						CAVES[#CAVES + 1] = {
							kind = tostring(entrance.kind or "cave"),
							position = position,
						}
					end
				end
			end
		end)
	end
end

