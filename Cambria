----- Target registry -----

local targets = {}
local stats = { creatures = 0, resources = 0, places = 0 }
local running = true

local function releaseVisuals(target)
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	if target.billboard then
		pcall(function()
			target.billboard:Destroy()
		end)
		target.billboard = nil
		target.label = nil
	end
	if target.lines then
		for _, line in ipairs(target.lines) do
			pcall(function()
				line.Visible = false
				line:Remove()
			end)
		end
		target.lines = nil
	end
	if target.tracer then
		pcall(function()
			target.tracer.Visible = false
			target.tracer:Remove()
		end)
		target.tracer = nil
	end
	target.hasVisual = false
end

local function dropTarget(key)
	local target = targets[key]
	if not target then
		return
	end
	releaseVisuals(target)
	if target.anchor then
		pcall(function()
			target.anchor:Destroy()
		end)
		target.anchor = nil
	end
	targets[key] = nil
end

local function clearAllTargets()
	for key in pairs(targets) do
		dropTarget(key)
	end
	clearAnchors()
	stats.creatures = 0
	stats.resources = 0
	stats.places = 0
end

----- Billboard and highlight builders -----

local function buildBillboard(part, offsetY)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Billboard"
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Size = UDim2.fromOffset(360, 54)
	billboard.StudsOffset = Vector3.new(0, offsetY, 0)
	billboard.Enabled = false

	local label = Instance.new("TextLabel")
	label.Name = "ESP_Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.RichText = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Bottom
	label.TextStrokeTransparency = 0.25
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = ""
	label.Parent = billboard

	billboard.Adornee = part
	billboard.Parent = part
	return billboard, label
end

local function ensureBillboard(target, part, offsetY)
	if target.billboard and target.billboard.Parent then
		target.billboard.Adornee = part
		target.billboard.StudsOffset = Vector3.new(0, offsetY, 0)
		return
	end
	target.billboard, target.label = buildBillboard(part, offsetY)
end

local function updateHighlight(target, part, color, enabled)
	if not enabled or not part then
		if target.highlight then
			pcall(function()
				target.highlight:Destroy()
			end)
			target.highlight = nil
		end
		return
	end
	local highlight = target.highlight
	if not highlight or not highlight.Parent or highlight.Adornee ~= part then
		if highlight then
			pcall(function()
				highlight:Destroy()
			end)
		end
		highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Chams"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.62
		highlight.OutlineTransparency = 0.05
		highlight.Adornee = part
		highlight.Parent = part
		target.highlight = highlight
	end
	highlight.FillColor = color
	highlight.OutlineColor = color
end

----- Label texts -----

local function tierText(creature)
	local tier = creature:GetAttribute("Tier")
	if type(tier) ~= "number" then
		return nil
	end
	local index = math.clamp(round(tier), 1, #TIER_NAMES)
	return string.format("%s T%d", TIER_NAMES[index], index)
end

local function creatureDetails(creature, distance)
	local details = {}
	if flag("CreatureTier", true) then
		local tier = tierText(creature)
		if tier then
			details[#details + 1] = tier
		end
	end
	if flag("CreatureDiet", true) then
		local diet = creature:GetAttribute("Diet")
		if type(diet) == "string" then
			details[#details + 1] = diet
		end
	end
	if flag("CreatureSize", true) then
		local size = creature:GetAttribute("Size")
		if type(size) == "number" then
			details[#details + 1] = string.format("%.1fx", size)
		end
	end
	if flag("CreatureHealth", true) then
		local humanoid = creature:FindFirstChildOfClass("Humanoid")
		if humanoid then
			details[#details + 1] = string.format("%d HP", round(humanoid.Health))
		end
	end
	if flag("CreatureGrowth", false) then
		local growth = creature:GetAttribute("Growth")
		if type(growth) == "number" then
			details[#details + 1] = string.format("%d%% grown", math.clamp(round(growth * 100), 0, 100))
		end
	end
	if flag("CreatureState", true) then
		local inCombatUntil = creature:GetAttribute("InCombatUntil")
		if type(inCombatUntil) == "number" and inCombatUntil > workspace:GetServerTimeNow() then
			details[#details + 1] = "IN FIGHT"
		end
		if creature:GetAttribute("Molting") == true then
			details[#details + 1] = "MOLTING"
		end
	end
	if flag("CreatureDistance", true) then
		details[#details + 1] = formatDistance(distance)
	end
	return details
end

local function creatureLabel(target, distance)
	local creature = target.creature
	if not creature or not creature.Parent then
		return ""
	end
	local title = target.player and target.player.Name or creature.Name
	if not flag("CreatureName", true) then
		local speciesOnly = (target.player and target.player:GetAttribute("CreatureName"))
			or creature:GetAttribute("CreatureName")
		title = (type(speciesOnly) == "string" and speciesOnly ~= "") and speciesOnly or "Creature"
	end
	local speciesText = ""
	if flag("CreatureSpecies", true) then
		local species = (target.player and target.player:GetAttribute("CreatureName"))
			or creature:GetAttribute("CreatureName")
		if type(species) == "string" and species ~= "" then
			speciesText = string.format("  <font color=\"#8B93A1\">%s</font>", species)
		end
	end
	local details = creatureDetails(creature, distance)
	local text = string.format("<font color=\"#FFFFFF\">%s</font>%s", title, speciesText)
	if #details > 0 then
		text = text .. string.format("\n<font color=\"#A6AEBE\">%s</font>", table.concat(details, "  |  "))
	end
	return text
end

