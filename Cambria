----- Runtime -----

resetFlagCache()

local collectAccumulator = 0
local renderAccumulator = 0
local chamsAccumulator = 0

local heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
	if not running then
		return
	end
	collectAccumulator = collectAccumulator + deltaTime
	renderAccumulator = renderAccumulator + deltaTime
	chamsAccumulator = chamsAccumulator + deltaTime

	if collectAccumulator >= COLLECT_INTERVAL then
		collectAccumulator = 0
		pcall(collectTargets)
	end

	local chamsDistance = flag("ChamsDistance", 450)
	if chamsAccumulator >= COLLECT_INTERVAL then
		chamsAccumulator = 0
		pcall(refreshChamsBudget, chamsDistance, flag("ChamsBudget", 60))
	end
	if renderAccumulator >= RENDER_INTERVAL then
		renderAccumulator = 0
		local origin = distanceOrigin()
		local settings = readSettings()
		for _, target in pairs(targets) do
			pcall(updateTarget, target, origin, settings)
		end
	end
end)

local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not running then
		return
	end
	if input.KeyCode == Enum.KeyCode.End then
		pcall(function()
			setFlag("CreatureESP", false)
			setFlag("CarcassESP", false)
			setFlag("NodeESP", false)
			setFlag("FossilESP", false)
			setFlag("DigESP", false)
			setFlag("NestESP", false)
			setFlag("PlaceESP", false)
			setFlag("CaveESP", false)
			setFlag("WarmESP", false)
			setFlag("CritterESP", false)
			clearAllTargets()
		end)
	end
end)

----- Teardown -----

local function destroy()
	if not running then
		return
	end
	running = false
	pcall(function()
		heartbeat:Disconnect()
	end)
	pcall(function()
		inputConnection:Disconnect()
	end)
	clearAllTargets()
	pcall(function()
		Window:Destroy()
	end)
	Airflow = nil
	if getgenv().RobScriptCambria then
		getgenv().RobScriptCambria = nil
	end
end

----- Public interface -----

getgenv().RobScriptCambria = {
	Version = "1.0",
	Actions = {
		Refresh = collectTargets,
		Clear = clearAllTargets,
		Destroy = destroy,
	},
	GetStats = function()
		return {
			creatures = stats.creatures,
			resources = stats.resources,
			places = stats.places,
			targets = (function()
				local count = 0
				for _ in pairs(targets) do
					count = count + 1
				end
				return count
			end)(),
		}
	end,
	Get = function(name, fallback)
		return flag(name, fallback)
	end,
	Set = function(name, value)
		return setFlag(name, value)
	end,
	GetTargets = function()
		local list = {}
		for _, target in pairs(targets) do
			local category = target.spec and target.spec.cat or "?"
			list[#list + 1] = {
				kind = category,
				name = (target.player and target.player.Name)
					or (target.place and target.place.name)
					or (target.instance and target.instance.Name)
					or (target.spec and (target.spec.cat .. " " .. tostring(target.key)))
					or "?",
				distance = target.distance,
				visible = target.hasVisual,
				billboard = target.billboard ~= nil and target.billboard.Enabled or false,
				chams = target.highlight ~= nil,
				text = target.text,
			}
		end
		return list
	end,
	Destroy = destroy,
}

