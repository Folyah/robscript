----- Collection pass with distance caps -----

local function collectTargets()
	local seen = {}
	-- Range is resolved before the collectors run, so they can skip far objects.
	local origin = distanceOrigin()
	collectOrigin = origin
	collectLimit = flag("RenderDistance", 1400) + 200
	pcall(collectCreatures, seen)
	pcall(collectCritters, seen)
	pcall(collectCarcasses, seen)
	pcall(collectNodes, seen)
	pcall(collectFossils, seen)
	pcall(collectDigSites, seen)
	pcall(collectNests, seen)
	pcall(collectPlaces, seen)
	pcall(collectCaves, seen)
	pcall(collectWarmZones, seen)

	local limit = collectLimit

	-- Distance caps per category: only the nearest targets stay drawn.
	local byCategory = {}
	for target in pairs(seen) do
		local spec = target.spec
		if spec then
			local position = target.spec.getPos and target.spec.getPos() or nil
			if position then
				local distance = (position - origin).Magnitude
				if distance <= limit then
					target.distance = distance
					target.color = spec.getColor and spec.getColor() or nil
					local bucket = byCategory[spec.cat]
					if not bucket then
						bucket = {}
						byCategory[spec.cat] = bucket
					end
					bucket[#bucket + 1] = target
				else
					seen[target] = nil
				end
			else
				seen[target] = nil
			end
		end
	end

	for target in pairs(seen) do
		target.capped = false
	end
	for category, bucket in pairs(byCategory) do
		local cap = CAP[category]
		if cap and #bucket > cap then
			table.sort(bucket, function(left, right)
				return left.distance < right.distance
			end)
			-- Over-cap targets stay registered but hidden, so they do not
			-- churn billboards every sync pass.
			for index = cap + 1, #bucket do
				bucket[index].capped = true
			end
		end
	end

	for _, target in pairs(targets) do
		target.seenNow = false
	end
	for target in pairs(seen) do
		target.misses = 0
		target.seenNow = true
	end
	for key, target in pairs(targets) do
		if not seen[target] then
			target.misses = target.misses + 1
			if target.misses >= DROP_AFTER_MISSES then
				dropTarget(key)
			end
		end
	end

	stats.creatures = 0
	stats.resources = 0
	stats.places = 0
	for key, target in pairs(targets) do
		local category = target.spec and target.spec.cat or ""
		if not target.seenNow or target.capped then
			-- out of range or hidden by the distance cap: not drawn, not counted
		elseif category == "Creature" or category == "Critter" then
			stats.creatures = stats.creatures + 1
		elseif category == "Place" or category == "Cave" or category == "Warm" then
			stats.places = stats.places + 1
		else
			stats.resources = stats.resources + 1
		end
	end
end

----- Rendering -----

local function projectBox(center, size)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local half = size * 0.5
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local depthHits = 0
	for x = -1, 1, 2 do
		for y = -1, 1, 2 do
			for z = -1, 1, 2 do
				local world = center + Vector3.new(half.X * x, half.Y * y, half.Z * z)
				local screen = camera:WorldToViewportPoint(world)
				if screen.Z > 0 then
					depthHits = depthHits + 1
					minX = math.min(minX, screen.X)
					minY = math.min(minY, screen.Y)
					maxX = math.max(maxX, screen.X)
					maxY = math.max(maxY, screen.Y)
				end
			end
		end
	end
	if depthHits < 2 then
		return nil
	end
	return minX, minY, maxX, maxY
end

local function hideBox(target)
	if target.lines then
		for _, line in ipairs(target.lines) do
			if line.Visible then
				line.Visible = false
			end
		end
	end
end

local function updateBox(target, color, center, size)
	if not center or not size then
		hideBox(target)
		return
	end
	local minX, minY, maxX, maxY = projectBox(center, size)
	if not minX then
		hideBox(target)
		return
	end
	if not target.lines then
		target.lines = { newLine(), newLine(), newLine(), newLine() }
	end
	local lines = target.lines
	if not lines[1] then
		return
	end
	local segments = {
		{ Vector2.new(minX, minY), Vector2.new(maxX, minY) },
		{ Vector2.new(maxX, minY), Vector2.new(maxX, maxY) },
		{ Vector2.new(maxX, maxY), Vector2.new(minX, maxY) },
		{ Vector2.new(minX, maxY), Vector2.new(minX, minY) },
	}
	for index = 1, 4 do
		local line = lines[index]
		if line then
			local segment = segments[index]
			line.From = segment[1]
			line.To = segment[2]
			line.Color = color
			line.Thickness = 1
			line.Visible = true
		end
	end
end

local function updateTracer(target, color, position, enabled)
	if not enabled then
		if target.tracer and target.tracer.Visible then
			target.tracer.Visible = false
		end
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local screen = camera:WorldToViewportPoint(position)
	if screen.Z <= 0 then
		if target.tracer then
			target.tracer.Visible = false
		end
		return
	end
	if not target.tracer then
		target.tracer = newLine()
	end
	if not target.tracer then
		return
	end
	local tracer = target.tracer
	tracer.From = Vector2.new(viewport.X * 0.5, viewport.Y)
	tracer.To = Vector2.new(screen.X, screen.Y)
	tracer.Color = color
	tracer.Thickness = 1
	tracer.Visible = true
end

local function hideTargetVisuals(target)
	if target.billboard and target.billboard.Enabled then
		target.billboard.Enabled = false
	end
	hideBox(target)
	if target.tracer and target.tracer.Visible then
		target.tracer.Visible = false
	end
	if target.highlight then
		pcall(function()
			target.highlight:Destroy()
		end)
		target.highlight = nil
	end
	target.hasVisual = false
end

local function updateTarget(target, origin, settings)
	local spec = target.spec
	if not spec then
		hideTargetVisuals(target)
		return
	end

	-- Over-cap targets are skipped before any instance or distance work.
	if target.capped then
		hideTargetVisuals(target)
		return
	end

	local part = target.part
	if not part or not part.Parent then
		part = spec.getPart and spec.getPart() or nil
	end
	local position = part and part.Position or (spec.getPos and spec.getPos() or nil)

	-- Things like meat have no meshes on the client, only a pivot, so they get
	-- a tiny invisible anchor part for the label to hang on.
	if not part and position then
		local anchor = target.anchor
		if not anchor or not anchor.Parent then
			anchor = createAnchor(position)
			target.anchor = anchor
		elseif (anchor.Position - position).Magnitude > 0.5 then
			anchor.CFrame = CFrame.new(position)
		end
		part = anchor
	end
	target.part = part

	if not position then
		hideTargetVisuals(target)
		return
	end

	local distance = (position - origin).Magnitude
	local color = target.color or (spec.getColor and spec.getColor()) or COLOR_CREATURE

	if target.capped then
		hideTargetVisuals(target)
		return
	end

	if part then
		local offsetY = spec.getOffsetY and spec.getOffsetY() or 3
		ensureBillboard(target, part, offsetY)
		target.billboard.MaxDistance = settings.renderDistance
		target.billboard.Enabled = true
		local now = os.clock()
		if now - target.lastTextAt >= TEXT_INTERVAL then
			target.lastTextAt = now
			local text = spec.getText and spec.getText(target, distance) or ""
			-- The first span is the title, so it takes the category color.
			text = string.gsub(text, '<font color="#FFFFFF">', '<font color="' .. colorToHex(color) .. '">', 1)
			if text ~= target.text then
				target.text = text
				target.label.Text = text
			end
		end
		target.label.TextColor3 = color
	end

	if distance > settings.renderDistance then
		hideTargetVisuals(target)
		return
	end

	local category = spec.cat

	if settings.box[category] then
		local now = os.clock()
		local center, size = target.boundsCenter, target.boundsSize
		if not center or now - (target.boundsAt or 0) >= BOUNDS_INTERVAL then
			target.boundsAt = now
			center, size = nil, nil
			if spec.getBounds then
				center, size = spec.getBounds()
			end
			target.boundsCenter, target.boundsSize = center, size
		end
		if center and size then
			updateBox(target, color, center, size)
		else
			hideBox(target)
		end
	else
		hideBox(target)
	end

	local chamsPart = nil
	if settings.chams[category] and target.allowChams and distance <= settings.chamsDistance then
		local now = os.clock()
		local cached = target.chamPart
		if not cached or not cached.Parent or now - (target.chamAt or 0) >= 1 then
			cached = spec.getChamPart and spec.getChamPart() or nil
			target.chamPart = cached
			target.chamAt = now
		end
		chamsPart = cached
	end
	updateHighlight(target, chamsPart, color, chamsPart ~= nil)

	updateTracer(target, color, position, spec.tracer == true and settings.tracer)
	target.hasVisual = true
end

----- Chams budget -----

local function refreshChamsBudget(chamsDistance, maxCount)
	local candidates = {}
	for _, target in pairs(targets) do
		target.allowChams = false
		if target.hasVisual and target.spec and target.distance and target.distance <= chamsDistance and not target.capped then
			candidates[#candidates + 1] = target
		end
	end
	table.sort(candidates, function(left, right)
		return (left.distance or 0) < (right.distance or 0)
	end)
	for index = 1, math.min(#candidates, maxCount) do
		candidates[index].allowChams = true
	end
end

